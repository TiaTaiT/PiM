// /docs/TSO/appendix-a.typ
// Приложение А
// Приложение A не входит в сквозную нумерацию разделов документа:
// его заголовок не нумеруется, а разделы нумеруются заново — 1, 2, 3, ...
#set heading(numbering: (..nums) => {
  let n = nums.pos()
  if n.len() == 1 { numbering("1", ..n) } else { numbering("1.1", ..n) }
})
#heading(numbering: none)[ПРИЛОЖЕНИЕ А]
#counter(heading).update(0)

#align(center)[*МЕТОДИКА ПРОВЕДЕНИЯ ИСПЫТАНИЙ*]

// Нумерация пунктов как <номер раздела>.<номер пункта>: 1.1, 2.1, 2.2, ...
#set enum(numbering: n => context {
  numbering("1.1", counter(heading).get().first(), n)
})

= Проверка состава комплекса ИТСО

Состав комплекса проверяется на соответствие реально смонтированного оборудования рабочей документации и подтверждается ведомостью смонтированного оборудования КИТСО.

= Проверка комплектности документации на комплекс

+ Комплектность проектной документации проверяется на соответствие перечню документов рабочего проекта (составу проекта), эксплуатационной документации – наличием формуляров, паспортов, сертификатов соответствия, инструкций (руководств) по эксплуатации, монтажу на смонтированное оборудование в соответствии с перечнем и подтверждается актом передачи технической документации.
+ Наличие сертификатов соответствия, используемого в ИТСО оборудования, проверяется при проверке инженерно-технических средств охраны (п.5.2.1.7 настоящей Программы).
+ Проверку оформленной исполнительной документации допускается проводить при проверке выполнения монтажных работ (п.5.2.1.8 настоящей Программы).

= Проверка электрических параметров комплекса ИТСО

+ Проверка электрических параметров проводится в объеме требований эксплуатационно-технической документации на конкретное техническое средство в процессе монтажных и пуско-наладочных работ.
+ Комиссия проверяет наличие оформленных актов об окончании монтажных и пусконаладочных работ.

= Проверка работоспособности инженерно-технических средств охраны

#let methodologies = json("../../config/methodologies.json")

#let render-methodology(item) = {
  let label-name = "methodology-" + str(item.id) + "-step-1"
  let lines = item.methodology.split("\n")
  let body = (
    (lines.at(0) + " <" + label-name + ">",) + lines.slice(1)
  ).join("\n").replace(
    "{{step:1}}",
    "#ref(label(\"" + label-name + "\"), supplement: none)",
  )
  eval(body, mode: "markup")
}

#let sections = methodologies.map(item => item.section).dedup()

#for section in sections [
  == #section
  #for item in methodologies.filter(item => item.section == section) [
    === #(item.names.join("; "))
    #render-methodology(item)
  ]
]
